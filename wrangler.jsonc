{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compascaribe",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    // Only the API goes through the Worker; the site itself is served as static assets.
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Non-secret gate settings. The model is configurable here; thresholds and limits
  // have documented defaults in src/domain/gate/config.js (override with GATE_* vars).
  // TYPESAFE_API_KEY is a secret: `wrangler secret put TYPESAFE_API_KEY`, or .dev.vars locally.
  "vars": {
    "JEV_MODEL": "jev-latest"
  },
  // Abuse protection for /api/gate: 10 classifications per minute per visitor IP.
  "ratelimits": [
    {
      "name": "GATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "compascaribe.com", "custom_domain": true },
    { "pattern": "www.compascaribe.com", "custom_domain": true }
  ]
}
