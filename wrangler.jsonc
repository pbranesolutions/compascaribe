{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compascaribe",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    // Only the API goes through the Worker; the site itself is served as static assets.
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Non-secret settings. The models are configurable here; thresholds and limits have
  // documented defaults in src/domain/gate/config.js (GATE_* vars) and
  // src/domain/conversation/config.js (CONVERSATION_* vars).
  // Secrets, never committed: `wrangler secret put TYPESAFE_API_KEY` (Jev) and
  // `wrangler secret put ANTHROPIC_API_KEY` (Claude), or .dev.vars locally.
  "vars": {
    "JEV_MODEL": "jev-latest",
    "CONVERSATION_MODEL": "claude-sonnet-5-5"
  },
  // Abuse and cost protection per visitor IP: 10 classifications and 8 generated
  // replies per minute (a reply is a billed model request; a person answering
  // takes longer than 8 seconds a turn, so a conversation never meets this).
  "ratelimits": [
    {
      "name": "GATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CONVERSATION_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "compascaribe.com", "custom_domain": true },
    { "pattern": "www.compascaribe.com", "custom_domain": true }
  ]
}
