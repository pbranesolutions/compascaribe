{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compascaribe",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "compascaribe.com", "custom_domain": true },
    { "pattern": "www.compascaribe.com", "custom_domain": true }
  ]
}
