{
  "name": "compascaribe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"tests/*.test.js\"",
    "check": "npm test && npm run build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node tests/browser/run.mjs --url http://localhost:5173",
    "test:live": "node tests/live/gate.live.mjs",
    "test:live:conversation": "node tests/live/conversation.live.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "vite": "^8.0.8",
    "wrangler": "^4.81.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0"
  }
}
